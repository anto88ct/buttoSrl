---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Buttò S.r.l. – Eccellenza nella gestione integrata dei servizi ambientali ad Assoro (EN). Smaltimento rifiuti, appalti pubblici di pulizia e sostenibilità circolare.',
  canonicalURL = Astro.url.pathname,
  noindex = false,
} = Astro.props;

const siteURL = Astro.site!.origin;
const canonical = new URL(canonicalURL, siteURL);
canonical.search = '';
canonical.hash = '';
canonical.pathname = canonical.pathname === '/' ? '/' : canonical.pathname.replace(/\/+$/, '');
const canonicalHref = canonical.href;
// Link previews (WhatsApp, social) show the logo on every page. Static file in public/.
const imageURL = new URL('/og-logo.png', siteURL).href;
const fullTitle = title === 'Home'
  ? 'Buttò S.r.l. | Servizi ambientali e rifiuti in Sicilia'
  : `${title} | Buttò S.r.l.`;

const breadcrumbItems = title === 'Home'
  ? []
  : [
      { name: 'Home', url: `${siteURL}/` },
      { name: title, url: canonicalHref },
    ];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:site_name" content="Buttò S.r.l." />
    <meta property="og:image:alt" content="Logo Buttò Carmelo S.r.l." />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Informazioni per assistenti AI" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" type="image/x-icon" href="/logo.ico" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": `${siteURL}/#organization`,
      "vatID": "IT01208350866",
      "name": "Buttò S.r.l.",
      "legalName": "Buttò Carmelo S.r.l.",
      "description": "Dal 1978, leader nella gestione integrata dei servizi ambientali ad Assoro (EN). Smaltimento rifiuti, appalti pubblici di pulizia, sostenibilità circolare.",
      "url": siteURL,
      "logo": `${siteURL}/logo.png`,
      "image": imageURL,
      "telephone": "+39 375 927 8085",
      "email": "servizi.butto@gmail.com",
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "18:00"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Via S. Giuseppe N°42",
        "addressLocality": "Assoro",
        "addressRegion": "EN",
        "postalCode": "94010",
        "addressCountry": "IT"
      },
      "foundingDate": "1978",
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": "Sicilia"
      },
      "sameAs": []
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@graph": [
        { "@type": "WebSite", "@id": `${siteURL}/#website`, "url": `${siteURL}/`, "name": "Buttò S.r.l.", "inLanguage": "it", "publisher": { "@id": `${siteURL}/#organization` } },
        { "@type": "WebPage", "@id": `${canonicalHref}#webpage`, "url": canonicalHref, "name": fullTitle, "description": description, "inLanguage": "it", "isPartOf": { "@id": `${siteURL}/#website` }, "about": { "@id": `${siteURL}/#organization` } }
      ]
    }).replace(/</g, "\\u003c")} />
    {breadcrumbItems.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbItems.map((item, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": item.name,
          "item": item.url,
        })),
      })} />
    )}
    <!-- i18n: apply stored language before paint to avoid FOUC -->
    <script is:inline>
      (function() {
        var lang = 'it';
        try { lang = localStorage.getItem('lang') === 'en' ? 'en' : 'it'; } catch {}
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Barlow+Condensed:wght@300;400;500;600;700;800&family=Barlow:wght@300;400;500;600&display=swap" />
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <noscript><style>.reveal,.reveal-left,.reveal-right,.reveal-scale { opacity: 1 !important; transform: none !important; }</style></noscript>
    <title>{fullTitle}</title>
  </head>

  <body class="overflow-x-clip">
    <!-- Scroll progress -->
    <div id="scroll-progress"></div>

    <!-- Custom cursor -->
    <div id="cursor"></div>
    <div id="cursor-ring"></div>

    <Navbar />
    <main class="page-content">
      <slot />
    </main>
    <Footer />

    <script>
      /* ── Scroll Progress ── */
      const bar = document.getElementById('scroll-progress')!;
      window.addEventListener('scroll', () => {
        const pct = window.scrollY / (document.body.scrollHeight - window.innerHeight);
        bar.style.transform = `scaleX(${Math.min(pct, 1)})`;
      }, { passive: true });

      /* ── Reveal on scroll ── */
      const revealEls = document.querySelectorAll(
        '.reveal, .reveal-left, .reveal-right, .reveal-scale'
      );
      const revealIO = new IntersectionObserver(
        (entries) => entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            revealIO.unobserve(e.target);
          }
        }),
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      revealEls.forEach(el => revealIO.observe(el));

      /* ── Counter animation ── */
      function animateCounter(el: HTMLElement) {
        const raw   = el.getAttribute('data-count') ?? '0';
        const num   = parseFloat(raw.replace(/[^0-9.]/g, ''));
        const suffix = raw.replace(/[0-9.,]/g, '');
        const prefix = el.getAttribute('data-prefix') ?? '';
        const dur   = 1800;
        const start = performance.now();

        function tick(now: number) {
          const p = Math.min((now - start) / dur, 1);
          const ease = 1 - Math.pow(1 - p, 4);
          const cur  = Math.round(ease * num * 10) / 10;
          el.textContent = prefix + (Number.isInteger(num) ? Math.round(cur).toLocaleString('it-IT') : cur.toLocaleString('it-IT')) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }

      const counterIO = new IntersectionObserver(
        (entries) => entries.forEach(e => {
          if (e.isIntersecting) {
            animateCounter(e.target as HTMLElement);
            counterIO.unobserve(e.target);
          }
        }),
        { threshold: 0.3 }
      );
      document.querySelectorAll('[data-count]').forEach(el => counterIO.observe(el));

      /* ── Custom Cursor ──────────────────────────────────────────── */
      const cursor     = document.getElementById('cursor')!;
      const cursorRing = document.getElementById('cursor-ring')!;

      if (window.innerWidth > 1024) {
        let mx = 0, my = 0, rx = 0, ry = 0;

        document.addEventListener('mousemove', e => {
          mx = e.clientX; my = e.clientY;
          cursor.style.left = mx + 'px';
          cursor.style.top  = my + 'px';
        });
        function animRing() {
          rx += (mx - rx) * 0.12;
          ry += (my - ry) * 0.12;
          cursorRing.style.left = rx + 'px';
          cursorRing.style.top  = ry + 'px';
          requestAnimationFrame(animRing);
        }
        animRing();
      }

      /* ── Navbar scroll ── */
      const header = document.querySelector('header')!;
      window.addEventListener('scroll', () => {
        header.classList.toggle('nav-scrolled', window.scrollY > 50);
      }, { passive: true });

      /* ── Header height var (pinned full-screen sections dock below it) ── */
      const setHeaderH = () => {
        document.documentElement.style.setProperty('--header-h', (header.offsetHeight + (parseFloat(getComputedStyle(header).top) || 0)) + 'px');
      };
      setHeaderH();
      new ResizeObserver(setHeaderH).observe(header);

      /* ── i18n ── */
      import { translations } from '../i18n/translations';

      type Lang = keyof typeof translations;

      function resolveKey(obj: any, dotPath: string): string | undefined {
        const val = dotPath.split('.').reduce((o, k) => o?.[k], obj);
        return typeof val === 'string' ? val : undefined;
      }

      (window as any).__applyLang = function(lang: string) {
        const t = translations[(lang as Lang)] ?? translations['it'];
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
          const val = resolveKey(t, el.dataset.i18n!);
          if (val) el.textContent = val;
        });
        document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach(el => {
          const val = resolveKey(t, el.dataset.i18nHtml!);
          if (val) el.innerHTML = val;
        });
        document.documentElement.lang = lang;
        document.documentElement.setAttribute('data-lang', lang);
        document.dispatchEvent(new CustomEvent('langchange', { detail: lang }));
      };

      let storedLang = 'it';
      try { storedLang = localStorage.getItem('lang') === 'en' ? 'en' : 'it'; } catch {}
      (window as any).__applyLang(storedLang);
    </script>

  </body>
</html>
