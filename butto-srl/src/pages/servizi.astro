---
import Layout from '../layouts/Layout.astro';
import HeroWatermark from '../components/HeroWatermark.astro';
import BotanicalBackground from '../components/BotanicalBackground.astro';
import ServiziScrollytelling from '../components/ServiziScrollytelling.astro';

const categorie = [
  {
    id: 'gestione-rifiuti',
    num: '01',
    icon: 'fa-recycle',
    title: 'Gestione Rifiuti',
    bg: 'bg-forest',
    dark: true,
    servizi: [
      { icon: 'fa-industry',      title: 'Logistica Industriale',   desc: "Trasporto e smaltimento certificato di rifiuti speciali e pericolosi, con tracciabilità digitale completa e conformità normativa.",  tags: ['Rifiuti speciali e pericolosi', 'Tracciabilità digitale'], img: 'https://images.unsplash.com/photo-1581092335397-9583eb92d232?auto=format&fit=crop&w=900&q=75' },
      { icon: 'fa-biohazard',     title: 'Smaltimento Rifiuti Speciali', desc: 'Ritiro e smaltimento a norma di rifiuti speciali pericolosi e non pericolosi, con gestione documentale e formulari conformi.',      tags: ['Pericolosi e non pericolosi', 'Formulari conformi'], img: 'https://images.unsplash.com/photo-1532996122724-e3c354a0b15b?auto=format&fit=crop&w=900&q=75' },
      { icon: 'fa-truck',         title: 'Raccolta Differenziata',  desc: 'Pianificazione e gestione di sistemi di raccolta differenziata per comuni e aziende, con obiettivi superiori al 65%.',              tags: ['Comuni e aziende', 'Oltre il 65% raccolto'], img: 'https://images.unsplash.com/photo-1611284446314-60a58ac0deb9?auto=format&fit=crop&w=900&q=75' },
    ],
  },
  {
    id: 'pulizie-pubbliche',
    num: '02',
    icon: 'fa-broom',
    title: 'Pulizie Enti Pubblici',
    bg: 'bg-parchment',
    dark: false,
    servizi: [
      { icon: 'fa-building-columns', title: 'Patrimonio Istituzionale', desc: 'Sanificazione di sedi istituzionali, uffici comunali e archivi storici con prodotti a ridotto impatto ambientale.',    tags: ['Uffici comunali e archivi', 'Prodotti a basso impatto'], img: 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=900&q=75' },
      { icon: 'fa-school',           title: 'Istituti Scolastici',      desc: 'Pulizia e igienizzazione di scuole di ogni ordine e grado, con protocolli dedicati alla sicurezza dei bambini.',       tags: ['Ogni ordine e grado', 'Protocolli di sicurezza'], img: 'https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=900&q=75' },
      { icon: 'fa-hospital',         title: 'Strutture Sanitarie',      desc: 'Sanificazione specializzata di strutture ospedaliere con metodologie certificate di controllo infezioni.',            tags: ['Ambienti ospedalieri', 'Controllo infezioni certificato'], img: 'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=900&q=75' },
    ],
  },
  {
    id: 'verde-urbano',
    num: '03',
    icon: 'fa-tree',
    title: 'Verde Urbano',
    bg: 'bg-forest',
    dark: true,
    servizi: [
      { icon: 'fa-seedling', title: 'Spazi Pubblici',        desc: 'Gestione del verde pubblico, parchi gioco e aree ricreative per il decoro urbano e la sicurezza cittadina.', tags: ['Parchi e aree gioco', 'Sicurezza cittadina'], img: 'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=900&q=75' },
      { icon: 'fa-road',     title: 'Manutenzione Stradale', desc: 'Pulizia e decoro di viali, marciapiedi, aree pedonali e spazi condivisi nelle aree urbane e periurbane.',  tags: ['Viali e marciapiedi', 'Aree urbane e periurbane'], img: 'https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?auto=format&fit=crop&w=900&q=75' },
    ],
  },
  {
    id: 'smaltimento-rifiuti-speciali',
    num: '04',
    icon: 'fa-earth-europe',
    title: 'Sostenibilità & Consulenza',
    bg: 'bg-parchment',
    dark: false,
    servizi: [
      { icon: 'fa-chart-bar',  title: 'Audit Ambientale', desc: "Analisi dei processi aziendali per identificare opportunità di riduzione degli sprechi e miglioramento dell'efficienza ambientale.", tags: ['Analisi dei processi', 'Efficienza ambientale'], img: 'https://images.unsplash.com/photo-1473448912268-2022ce9509d8?auto=format&fit=crop&w=900&q=75' },
      { icon: 'fa-circle-dot', title: 'Piano Zero Waste',  desc: 'Strategie personalizzate per raggiungere obiettivi di zero conferimento in discarica attraverso recupero e riciclo.',           tags: ['Zero conferimento in discarica', 'Recupero e riciclo'], img: 'https://images.unsplash.com/photo-1542601098-3adb3baeb1ec?auto=format&fit=crop&w=900&q=75' },
    ],
  },
];

const certs = ['ISO 14001:2015', 'ISO 9001:2015', 'Albo Gestori Ambientali', 'Attestazione SOA'];

const faqs = [
  {
    q: 'Quali tipologie di rifiuti gestite?',
    a: "L'azienda opera secondo le categorie di iscrizione all'Albo Nazionale Gestori Ambientali, garantendo servizi specializzati e conformi per ogni tipologia autorizzata.",
  },
  {
    q: 'Offrite servizi di emergenza?',
    a: 'Sì, sono disponibili interventi straordinari con sistemi di reperibilità concordata per rispondere a situazioni urgenti.',
  },
  {
    q: 'Come viene garantita la tracciabilità?',
    a: 'Attraverso registri digitali, formulari elettronici e integrazione completa con il sistema RENTRI per la massima trasparenza operativa.',
  },
  {
    q: 'In quali zone operate e a chi vi rivolgete?',
    a: 'La nostra sede è ad Assoro, in provincia di Enna, e operiamo in Sicilia per enti pubblici e aziende private. Contattaci indicando il luogo e il servizio richiesto: valuteremo insieme le esigenze del tuo territorio.',
  },
  {
    q: 'Come posso richiedere un preventivo?',
    a: 'Puoi utilizzare il modulo nella pagina Contatti oppure contattarci telefonicamente o via email. Per aiutarci a valutare la richiesta, indica il luogo di intervento, il servizio, le quantità o le superfici interessate e le tempistiche desiderate.',
  },
  {
    q: 'Quali informazioni servono per richiedere il ritiro dei rifiuti?',
    a: 'Indica la tipologia di rifiuto, la quantità stimata, il luogo di ritiro e le condizioni di accesso. Se disponibili, aggiungi il codice CER/EER e la documentazione relativa al rifiuto. Se non disponi di tutti i dati, segnalalo nella richiesta: il team ti aiuterà a capire quali informazioni approfondire prima di organizzare il servizio.',
  },
  {
    q: 'Posso concordare interventi periodici?',
    a: 'Puoi richiedere una programmazione per raccolta rifiuti, pulizie o manutenzione del verde. Frequenza, modalità e disponibilità vengono valutate con il nostro team in base al servizio, alla sede e alle necessità operative.',
  },
  {
    q: 'Dove posso consultare le vostre certificazioni e autorizzazioni?',
    a: 'La pagina Certificazioni presenta le iscrizioni, le certificazioni e le categorie di rifiuti trattate. Per documentazione relativa a un servizio specifico o a una richiesta di fornitura, contatta il nostro team.',
  },
];
---

<Layout
  title="Servizi Ambientali e Gestione Rifiuti"
  description="I servizi di Buttò S.r.l.: gestione e smaltimento rifiuti speciali, pulizie enti pubblici e verde urbano per il territorio siciliano."
  ogImage="/garbage_cleaning.jpg"
>

  <!-- ══════════════════════ HERO ══════════════════════ -->
  <section class="relative py-36 bg-ivory dot-grid overflow-hidden">

    <HeroWatermark word="LAVORO" />

    <div class="absolute top-8 right-14 hidden lg:flex items-center gap-3 pointer-events-none select-none">
      <span class="font-condensed text-[0.6rem] tracking-[0.3em] uppercase text-muted/40">Catalogo Servizi</span>
      <span class="font-condensed font-700 text-[0.6rem] tracking-[0.2em] text-ochre/50">2025</span>
    </div>

    <div class="max-w-screen-2xl mx-auto px-6 lg:px-14 relative z-10">
      <span data-i18n="servizi.hero.eyebrow" class="overline text-ochre mb-5 block reveal">I Nostri Servizi</span>
      <h1 data-i18n-html="servizi.hero.h1html" class="display-xl text-ink reveal delay-1" style="text-wrap: balance;">
        Custodi del<br/>
        <em class="text-forest-soft not-italic">Bene Comune</em>
      </h1>
      <p data-i18n="servizi.hero.body" class="font-body text-muted text-xl max-w-2xl leading-relaxed mt-8 reveal delay-2">
        Soluzioni integrate per l'ambiente attraverso una gestione consapevole delle risorse e la cura meticolosa degli spazi pubblici siciliani.
      </p>

      <div class="flex flex-wrap gap-3 mt-10 reveal delay-3">
        {categorie.map(({ id, num, title }, ci) => (
          <a href={`#${id}`} class="cat-nav-link font-condensed font-600 text-[0.7rem] uppercase tracking-[0.14em] px-4 py-2.5 border border-linen text-muted hover:border-ochre hover:text-ochre transition-all duration-200">
            <span>{num} — </span><span data-i18n={`servizi.categorie.${ci}.title`}>{title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════ SCROLLYTELLING ══════════════════════ -->
  <ServiziScrollytelling />

  <!-- ══════════════════════ SERVICES INTRO ══════════════════════ -->
  <section class="relative py-24 md:py-32 bg-forest grain grain-anim overflow-hidden">
    <div class="max-w-screen-2xl mx-auto px-6 lg:px-14 relative z-10">
      <div class="max-w-2xl mx-auto text-center reveal-blur">
        <div class="h-px w-10 bg-ochre mx-auto mb-6"></div>
        <h2 data-i18n="servizi.intro.h2" class="display-lg italic text-ivory" style="text-wrap: balance;">
          I Nostri Servizi
        </h2>
        <p data-i18n="servizi.intro.body" class="font-body text-ivory/70 text-lg leading-relaxed mt-6">
          Quattro aree di competenza integrate, pensate per rispondere con precisione normativa alle esigenze di enti pubblici e imprese in tutta la Sicilia.
        </p>
      </div>

      <div class="relative mt-16 reveal-blur delay-2">
        <div class="absolute left-[12%] right-[12%] top-7 h-px bg-white/10 hidden sm:block" aria-hidden="true"></div>
        <div class="relative z-10 flex flex-wrap justify-center gap-x-8 sm:gap-x-0 sm:justify-between gap-y-8 max-w-2xl mx-auto">
          {categorie.map(({ id, icon, title }, ci) => (
            <a href={`#${id}`} class="group flex flex-col items-center gap-3 w-24 text-center">
              <span class="w-14 h-14 rounded-full border border-white/12 bg-forest group-hover:border-ochre/60 group-hover:bg-ochre/10 flex items-center justify-center transition-all duration-300">
                <i class:list={['fa-solid', icon, 'text-lg text-ochre/70 group-hover:text-ochre transition-colors']}></i>
              </span>
              <span data-i18n={`servizi.categorie.${ci}.title`} class="font-condensed font-600 text-[0.68rem] uppercase tracking-[0.06em] text-ivory/60 group-hover:text-ivory transition-colors leading-tight">
                {title}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════ SERVICE CATEGORIES ══════════════════════ -->
  {categorie.map(({ id, num, icon, title, bg, dark, servizi }, ci) => (
    <section
      id={id}
      class:list={[
        'relative py-24 overflow-hidden service-section',
        bg,
        dark ? 'grain grain-anim spotlight-section' : '',
      ]}
    >
      {(id === 'gestione-rifiuti' || id === 'verde-urbano') && <BotanicalBackground ambient={false} />}
      <div
        class:list={[
          'absolute top-1/2 -translate-y-1/2 pointer-events-none select-none hidden xl:flex flex-col items-center gap-4',
          dark ? 'left-5' : 'right-5',
        ]}
      >
        <span
          class:list={[
            'font-condensed font-700 text-[0.55rem] tracking-[0.35em] uppercase',
            dark ? 'text-ivory/20' : 'text-ink/18',
          ]}
          style="writing-mode: vertical-rl; transform: rotate(180deg);"
        >
          §{num} — Buttò S.r.l.
        </span>
        <span
          class="w-px h-14 block"
          style={dark ? 'background: rgba(242,237,223,0.1)' : 'background: rgba(30,28,23,0.08)'}
        ></span>
      </div>

      <div class="max-w-screen-2xl mx-auto px-6 lg:px-14 relative z-10">

        <div class:list={[
          'flex items-center gap-6 mb-16 pb-8 border-b reveal-blur',
          dark ? 'border-white/10' : 'border-linen',
        ]}>
          <span class:list={[
            'font-condensed font-800 text-[5rem] leading-none tracking-tighter select-none',
            dark ? 'text-ivory/[0.07]' : 'text-ink/[0.06]',
          ]}>{num}</span>
          <div>
            <div class="flex items-center gap-3 mb-1">
              <i class:list={['fa-solid', icon, 'text-2xl text-ochre service-icon-inner']}></i>
              <h2 data-i18n={`servizi.categorie.${ci}.title`} class:list={[
                'display-sm italic',
                dark ? 'text-ivory' : 'text-ink',
              ]} style="text-wrap: balance;">{title}</h2>
            </div>
            <div class="h-px w-16 bg-ochre mt-2"></div>
          </div>
        </div>

        <div class:list={[
          'grid grid-cols-1 md:grid-cols-2 gap-px',
          servizi.length === 3 ? 'lg:grid-cols-3' : '',
          dark ? 'bg-white/10' : 'bg-black/[0.06]',
        ]}>
          {servizi.map(({ icon: sIcon, title: sTitle, desc, tags, img }, si) => (
            <div
              class:list={[
                'group relative p-10 flex flex-col gap-6 cursor-default bento-card reveal-blur overflow-hidden',
                dark ? 'bg-forest-mid' : 'bg-ivory',
              ]}
              style={`transition-delay: ${si * 0.1}s`}
            >
              {/* Background image layer — clips to card via overflow-hidden on parent */}
              <div class="absolute inset-0 pointer-events-none">
                <div
                  class="absolute inset-0 bg-cover bg-center opacity-0 group-hover:opacity-100 scale-100 group-hover:scale-110 bento-bg-img"
                  style={`background-image: url('${img}');`}
                  role="img"
                  aria-label={sTitle}
                ></div>
              </div>
              {/* Gradient overlay — stronger at bottom for text legibility */}
              <div
                class="absolute inset-0 opacity-0 group-hover:opacity-100 bento-overlay pointer-events-none"
                style="background: linear-gradient(to top, rgba(13,26,16,0.92) 0%, rgba(13,26,16,0.65) 45%, rgba(13,26,16,0.35) 100%);"
                aria-hidden="true"
              ></div>

              {/* Icon */}
              <div class:list={[
                'w-14 h-14 rounded-full border flex items-center justify-center flex-shrink-0 relative z-10',
                dark ? 'border-white/12 bg-white/[0.03] group-hover:border-ochre/60' : 'border-linen bg-ochre/[0.06] group-hover:border-ochre/60',
                'transition-colors duration-300',
              ]}>
                <i class:list={[
                  'fa-solid', sIcon,
                  'text-lg text-ochre/70 group-hover:text-ochre transition-colors service-icon-inner',
                ]}></i>
              </div>

              {/* Content */}
              <div class="flex-1 relative z-10">
                <h3 data-i18n={`servizi.categorie.${ci}.servizi.${si}.title`} class:list={[
                  'font-serif text-2xl italic leading-tight mb-3 transition-colors duration-500',
                  dark ? 'text-ivory group-hover:text-white' : 'text-ink group-hover:text-white',
                ]} style="text-wrap: balance;">{sTitle}</h3>
                <p data-i18n={`servizi.categorie.${ci}.servizi.${si}.desc`} class:list={[
                  'font-body text-[0.94rem] leading-relaxed transition-colors duration-500',
                  dark ? 'text-ivory/70 group-hover:text-ivory/90' : 'text-ink/70 group-hover:text-ivory/85',
                ]}>{desc}</p>

                {tags && (
                  <ul class="flex flex-wrap gap-2 mt-5">
                    {tags.map((tag, ti) => (
                      <li class:list={[
                        'font-condensed font-600 text-[0.62rem] uppercase tracking-[0.06em] px-2.5 py-1.5 border flex items-center gap-1.5 transition-colors duration-500',
                        dark
                          ? 'border-white/12 text-ivory/60 group-hover:border-white/25 group-hover:text-ivory/85'
                          : 'border-linen text-ink/60 group-hover:border-white/30 group-hover:text-ivory/85',
                      ]}>
                        <i class="fa-solid fa-check text-[8px] text-ochre/70"></i>
                        <span data-i18n={`servizi.categorie.${ci}.servizi.${si}.tags.${ti}`}>{tag}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              {/* CTA */}
              <span class="relative z-10 font-condensed font-700 text-[0.65rem] uppercase tracking-[0.16em] text-ochre/70 group-hover:text-ochre flex items-center gap-2 group-hover:gap-3 transition-all duration-300">
                <span data-i18n="servizi.learnMore">Informazioni</span> <i class="fa-solid fa-arrow-right text-[9px]"></i>
              </span>
            </div>
          ))}
        </div>

      </div>
    </section>
  ))}

  <!-- ══════════════════════ CERTIFICATIONS ══════════════════════ -->
  <section id="qualita-certificata" class="py-24 bg-forest grain grain-anim overflow-hidden">
    <div class="max-w-screen-2xl mx-auto px-6 lg:px-14 mb-16">
      <div class="text-center reveal-blur">
        <span data-i18n="servizi.certs.eyebrow" class="overline text-ochre">Le Nostre Garanzie</span>
        <div class="h-px w-8 bg-ochre mx-auto mt-4 mb-0"></div>
        <h2 data-i18n="servizi.certs.h2" class="display-sm text-ivory italic mt-5" style="text-wrap: balance;">Qualità Certificata</h2>
      </div>
    </div>

    <div class="relative overflow-hidden">
      <div class="absolute inset-y-0 left-0 w-28 z-10 pointer-events-none" style="background: linear-gradient(to right, #0D1A10, transparent);"></div>
      <div class="absolute inset-y-0 right-0 w-28 z-10 pointer-events-none" style="background: linear-gradient(to left, #0D1A10, transparent);"></div>

      <div class="marquee-track cert-track">
        {[...certs, ...certs, ...certs, ...certs].map((c) => (
          <a
            href="/certificazioni"
            class="group cert-card flex-shrink-0 mx-5 flex flex-col items-center gap-5 px-14 py-10 border border-white/8 hover:border-ochre/35 transition-all duration-500 hover:bg-forest-mid"
            style="min-width: 230px;"
          >
            <i aria-hidden="true" class="cert-icon fa-solid fa-certificate text-4xl text-ochre/70 group-hover:text-ochre transition-colors duration-200"></i>
            <p class="font-serif text-2xl md:text-3xl font-medium text-ivory/90 group-hover:text-ivory text-center text-balance leading-tight transition-colors">{c}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════ CTA ══════════════════════ -->
  <section class="py-32 md:py-40 lg:py-48 bg-forest grain relative overflow-hidden">
    <div class="absolute right-0 bottom-0 pointer-events-none select-none" aria-hidden="true">
      <span class="font-condensed font-800 text-[20vw] text-ivory/[0.1] leading-none tracking-tighter">TALK</span>
    </div>
    <div class="absolute top-12 right-12 w-32 h-32 border border-ochre/10 rotate-45 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-20 right-20 w-16 h-16 border border-ochre/15 rotate-45 pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-screen-2xl mx-auto px-6 lg:px-14 relative z-10">
      <div class="max-w-6xl mx-auto reveal">
        <h2 data-i18n-html="servizi.cta.h2html" class="display-xl text-ivory text-balance mb-10">
          Ogni territorio<br/>
          <em class="text-sage not-italic">è unico</em>
        </h2>
        <p data-i18n="servizi.cta.body" class="font-body text-ivory/70 text-xl text-pretty leading-relaxed mb-12 max-w-2xl">
          Il nostro team è pronto ad ascoltarti e progettare il servizio più adatto alla tua realtà.
        </p>
        <div class="flex flex-wrap gap-5">
          <a href="/contatti" class="btn-primary text-base px-10 py-5">
            <span data-i18n="servizi.cta.btn">Richiedi un preventivo</span> <i aria-hidden="true" class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════ FAQ ══════════════════════ -->
  <section class="relative py-24 bg-parchment overflow-hidden">

    <div class="absolute top-1/2 -translate-y-1/2 right-5 pointer-events-none select-none hidden xl:flex flex-col items-center gap-4">
      <span
        class="font-condensed font-700 text-[0.55rem] tracking-[0.35em] uppercase text-ink/18"
        style="writing-mode: vertical-rl; transform: rotate(180deg);"
      >§FAQ — Buttò S.r.l.</span>
      <span class="w-px h-14 block" style="background: rgba(30,28,23,0.08)"></span>
    </div>

    <div class="max-w-screen-2xl mx-auto px-6 lg:px-14">

      <div class="flex items-center gap-6 mb-16 pb-8 border-b border-linen reveal-blur">
        <span class="font-condensed font-800 text-[5rem] leading-none tracking-tighter select-none text-ink/[0.06]">FAQ</span>
        <div>
          <div class="flex items-center gap-3 mb-1">
            <i class="fa-solid fa-circle-question text-2xl text-ochre"></i>
            <h2 data-i18n="servizi.faq.h2" class="display-sm italic text-ink" style="text-wrap: balance;">Domande Frequenti</h2>
          </div>
          <div class="h-px w-16 bg-ochre mt-2"></div>
        </div>
      </div>

      <div class="max-w-5xl mx-auto space-y-4">
        {faqs.map(({ q, a }, i) => (
          <details class="faq-item rounded-lg border border-linen bg-ivory shadow-sm" name="service-faq" open={i === 0}>
            <summary class="faq-trigger flex items-start gap-4 sm:gap-6 p-6 sm:p-8 text-left group">
              <span aria-hidden="true" class="font-condensed font-semibold text-lg text-forest-soft tabular-nums shrink-0 pt-1">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="font-body text-xl sm:text-2xl font-semibold text-ink leading-snug flex-1 text-pretty">
                {q}
              </span>
              <span aria-hidden="true" class="faq-icon-box shrink-0 size-8 rounded-full border border-linen flex items-center justify-center text-forest mt-0.5">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d="M5 12h14" stroke-linecap="round" />
                  <path class="faq-plus" d="M12 5v14" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-7 sm:px-8 sm:pb-8">
              <p class="font-body text-ink/80 text-lg sm:text-xl leading-relaxed text-pretty max-w-3xl sm:ml-11">{a}</p>
            </div>
          </details>
        ))}
        <div class="flex flex-wrap items-center justify-between gap-5 px-1 pt-6">
          <p class="font-body text-lg text-ink/80 text-pretty">Hai una richiesta specifica? Parliamone insieme.</p>
          <a href="/contatti" class="btn-primary"><span data-i18n="nav.contattaci">Contattaci</span></a>
        </div>
      </div>

    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(({ q, a }) => ({
      "@type": "Question",
      "name": q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": a,
      },
    })),
  })} />

</Layout>

<style is:global>
  .reveal-blur {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(5px);
    transition:
      opacity  0.85s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.85s cubic-bezier(0.16, 1, 0.3, 1),
      filter   0.85s ease;
  }
  .reveal-blur.visible {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }
  .spotlight-section {
    --sx: 50%;
    --sy: 50%;
  }
  .spotlight-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      680px circle at var(--sx) var(--sy),
      rgba(196, 146, 42, 0.072),
      transparent 60%
    );
    pointer-events: none;
    z-index: 1;
    transition: background 0.05s linear;
  }
  @keyframes grainShift {
    0%, 100% { background-position:   0px   0px; }
    20%       { background-position: -28px -14px; }
    40%       { background-position:  12px  26px; }
    60%       { background-position: -14px  10px; }
    80%       { background-position:  22px -22px; }
  }
  .grain-anim::after {
    animation: grainShift 0.7s steps(1) infinite;
  }
  @keyframes iconPop {
    0%   { transform: scale(0.55) rotate(-8deg); opacity: 0; }
    55%  { transform: scale(1.18) rotate(4deg);  opacity: 1; }
    100% { transform: scale(1)    rotate(0deg);  opacity: 1; }
  }
  .section-active .service-icon-inner {
    animation: iconPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .section-active .bento-card:nth-child(2) .service-icon-inner { animation-delay: 0.12s; }
  .section-active .bento-card:nth-child(3) .service-icon-inner { animation-delay: 0.24s; }
  .section-active .bento-card:nth-child(4) .service-icon-inner { animation-delay: 0.36s; }
  .cert-track {
    animation-duration: 26s;
  }

  .cert-icon {
    animation: certificate-float 3.6s ease-in-out infinite;
    animation-play-state: paused;
  }
  .cert-card:nth-child(4n + 2) .cert-icon { animation-delay: -0.9s; }
  .cert-card:nth-child(4n + 3) .cert-icon { animation-delay: -1.8s; }
  .cert-card:nth-child(4n + 4) .cert-icon { animation-delay: -2.7s; }
  .cert-card.is-in-view .cert-icon { animation-play-state: running; }
  .cert-motion-paused .cert-icon { animation-play-state: paused; }
  @keyframes certificate-float {
    0%, 100% { transform: translateY(0) rotate(-4deg) scale(1); }
    50% { transform: translateY(-6px) rotate(4deg) scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cert-icon { animation: none; }
    .cert-track { animation: none; }
  }

  /* Bento card image hover */
  .bento-bg-img {
    transition:
      opacity  0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bento-overlay {
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Reset stagger delay on hover so transitions feel instant */
  .bento-card:hover,
  .bento-card:hover * {
    transition-delay: 0s !important;
  }
  /* Mobile: show a faint static bg hint (no hover on touch) */
  @media (hover: none) {
    .bento-bg-img  { opacity: 0.08 !important; transform: scale(1) !important; }
    .bento-overlay { opacity: 0.4 !important; }
  }
  .cat-nav-link.is-active {
    border-color: var(--ochre);
    color: var(--ochre);
  }

  .faq-trigger {
    cursor: pointer;
    list-style: none;
  }
  .faq-trigger::-webkit-details-marker { display: none; }
  .faq-trigger:focus-visible {
    outline: 2px solid var(--forest-soft);
    outline-offset: 4px;
    border-radius: 0.5rem;
  }
  .faq-trigger:hover { background: rgb(196 146 42 / 5%); }
  .faq-item[open] { border-color: var(--forest-soft); }
  .faq-item[open] .faq-plus { display: none; }
  .faq-item[open] .faq-icon-box {
    background: var(--forest);
    color: var(--ivory);
    border-color: var(--forest);
  }
</style>

<script>
  const certificates = document.getElementById('qualita-certificata');
  if (certificates) {
    const syncCertificateMotion = () => certificates.classList.toggle('cert-motion-paused', document.hidden);
    syncCertificateMotion();
    document.addEventListener('visibilitychange', syncCertificateMotion);
    const certificateIO = new IntersectionObserver(entries => {
      entries.forEach(entry => entry.target.classList.toggle('is-in-view', entry.isIntersecting));
    });
    certificates.querySelectorAll('.cert-card').forEach(card => certificateIO.observe(card));
  }

  const blurIO = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('visible');
        blurIO.unobserve(e.target);
      }
    }),
    { threshold: 0.07, rootMargin: '0px 0px -30px 0px' }
  );
  document.querySelectorAll('.reveal-blur').forEach(el => blurIO.observe(el));

  document.querySelectorAll<HTMLElement>('.spotlight-section').forEach(section => {
    section.addEventListener('mousemove', e => {
      const r = section.getBoundingClientRect();
      section.style.setProperty('--sx', ((e.clientX - r.left) / r.width * 100).toFixed(1) + '%');
      section.style.setProperty('--sy', ((e.clientY - r.top) / r.height * 100).toFixed(1) + '%');
    });
  });

  const sectionIO = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('section-active');
    }),
    { threshold: 0.18 }
  );
  document.querySelectorAll('.service-section').forEach(s => sectionIO.observe(s));

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.cat-nav-link');
  const activeIO = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) {
        const id = e.target.id;
        navLinks.forEach(link => {
          link.classList.toggle('is-active', link.getAttribute('href') === `#${id}`);
        });
      }
    }),
    { rootMargin: '-38% 0px -38% 0px' }
  );
  document.querySelectorAll<HTMLElement>('.service-section').forEach(s => activeIO.observe(s));

</script>
