---
import Layout from "../layouts/Layout.astro";

const info = [
  {
    icon: "fa-location-dot",
    titleKey: "contatti.info.sedeLabel",
    title: "Sede Operativa",
    lines: ["Via S. Giuseppe N°42", "Assoro (EN), 94010 · Sicilia"],
    links: ["https://maps.google.com/?q=Via+San+Giuseppe+42,+Assoro,+EN,+Sicilia"],
  },
  {
    icon: "fa-phone",
    titleKey: "contatti.info.telLabel",
    title: "Telefono",
    lines: ["+39 375 927 8085"],
    links: ["tel:+393759278085"],
    noteKey: "contatti.info.telNote",
    note: "Lun–Ven 08:30–18:00",
  },
  {
    icon: "fa-envelope",
    titleKey: "contatti.info.emailLabel",
    title: "Email",
    lines: ["servizi.butto@gmail.com", "impresabutto@pec.it"],
    links: ["mailto:servizi.butto@gmail.com", "mailto:impresabutto@pec.it"],
  },
];

const schedule = [
  {
    dayKey: "contatti.info.schedule.0.day",
    day: "Lunedì – Venerdì",
    hoursKey: undefined,
    hours: "08:30 – 18:00",
    open: true,
  },
  {
    dayKey: "contatti.info.schedule.1.day",
    day: "Sabato",
    hoursKey: undefined,
    hours: "09:00 – 12:00",
    open: true,
  },
  {
    dayKey: "contatti.info.schedule.2.day",
    day: "Domenica",
    hoursKey: "contatti.info.schedule.2.hours",
    hours: "Chiuso",
    open: false,
  },
];

const temi = [
  "Richiesta Informazioni Generali",
  "Preventivo Servizi Ambientali",
  "Segnalazione Ambientale Urgente",
  "Appalti e Gare Pubbliche",
  "Collaborazione Professionale",
  "Altro",
];
---

<Layout
  title="Contatti e Richiesta Preventivo Gratuito"
  description="Contatta Buttò S.r.l. – Entra in contatto con il team di gestione ambientale di Assoro (EN) per preventivi, collaborazioni e segnalazioni urgenti."
  ogImage="/cleaning.jpg"
>
  <!-- ══════════════════════ MAIN CONTENT ══════════════════════ -->
  <section class="pb-20 lg:pb-28 bg-ivory dot-grid" style="padding-top: calc(var(--header-h, 5.5rem) + 2rem);">
    <div class="max-w-screen-2xl mx-auto px-6 lg:px-14">
      <div class="grid lg:grid-cols-12 gap-8 xl:gap-12 items-start">
        <!-- LEFT: info panel -->
        <div class="order-2 lg:order-1 lg:col-span-4 space-y-6">
          <div>
            <h2 data-i18n="contatti.info.h2" class="font-serif text-4xl text-forest italic text-balance mb-3">Informazioni</h2>
          </div>

          <div class="overflow-hidden rounded-2xl border border-linen bg-white shadow-sm">
            {
              info.map(({ icon, titleKey, title, lines, links, noteKey, note }, i) => (
                <div
                  class={`group flex gap-4 items-start p-6 ${i < info.length - 1 ? "border-b border-linen" : ""}`}
                >
                  <div class="size-11 rounded-xl bg-forest/5 flex items-center justify-center shrink-0 text-forest-soft">
                    <i
                      aria-hidden="true" class={`fa-solid ${icon} text-lg`}
                    />
                  </div>
                  <div class="min-w-0">
                    <p
                      data-i18n={titleKey}
                      class="font-body font-semibold text-base text-forest mb-2"
                    >
                      {title}
                    </p>
                    {lines.map((line, lineIndex) => (
                      <p class="font-body text-ink/80 text-base leading-relaxed break-words">
                        {links[lineIndex] ? (
                          <a href={links[lineIndex]} class="contact-info-link">{line}</a>
                        ) : line}
                      </p>
                    ))}
                    {note && (
                      <p
                        data-i18n={noteKey}
                        class="font-body text-muted text-sm mt-2"
                      >
                        {note}
                      </p>
                    )}
                  </div>
                </div>
              ))
            }
          </div>

          <div class="overflow-hidden rounded-2xl bg-forest text-ivory p-6 shadow-sm">
            <div class="flex items-center gap-3 pb-5 border-b border-ivory/15">
              <i class="fa-solid fa-clock text-ochre text-sm"></i>
              <p
                data-i18n="contatti.info.orari"
                class="font-body font-semibold text-lg text-ivory"
              >
                Orari di Apertura
              </p>
            </div>
            <div class="divide-y divide-ivory/10">
              {
                schedule.map(({ dayKey, day, hoursKey, hours, open }) => (
                  <div class="flex flex-wrap items-center justify-between gap-3 py-4 last:pb-0">
                    <span
                      data-i18n={dayKey}
                      class="font-body text-ivory/80 text-base"
                    >
                      {day}
                    </span>
                    <span
                      data-i18n={hoursKey}
                      class={`font-body font-semibold text-base tabular-nums ${open ? "text-ivory" : "text-ochre-light"}`}
                    >
                      {hours}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>


        </div>

        <!-- RIGHT: form -->
        <div class="order-1 lg:order-2 lg:col-span-8">
          <div class="rounded-2xl bg-white border border-linen p-6 sm:p-8 xl:p-12 shadow-sm">
            <div class="relative z-10">
              <h1
                data-i18n="contatti.form.h3"
                class="font-serif text-4xl sm:text-5xl text-forest italic leading-tight text-balance mb-4"
              >
                Inviaci un Messaggio
              </h1>
              <p
                data-i18n="contatti.form.subNote"
                class="font-body text-ink/70 text-lg leading-relaxed text-pretty mb-8 pb-8 border-b border-linen"
              >
                Risponderemo entro 24 ore lavorative.
              </p>

              <form id="contact-form" method="POST" class="space-y-7">
                <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
                  <label for="form-website">Lascia vuoto questo campo</label>
                  <input
                    id="form-website"
                    type="text"
                    name="website"
                    tabindex="-1"
                    autocomplete="off"
                  />
                </div>
                <div class="grid md:grid-cols-2 gap-6">
                  <div class="space-y-2">
                    <label
                      for="form-name"
                      class="font-body font-semibold text-base text-ink flex flex-wrap items-center gap-2"
                    >
                      <span data-i18n="contatti.form.nome">Nome Completo</span>
                    </label>
                    <input
                      id="form-name"
                      type="text"
                      name="name"
                      placeholder="Mario Rossi"
                      autocomplete="name"
                      required
                      aria-required="true"
                      class="contact-field"
                    />
                  </div>
                  <div class="space-y-2">
                    <label
                      for="form-email"
                      class="font-body font-semibold text-base text-ink flex flex-wrap items-center gap-2"
                    >
                      <span data-i18n="contatti.form.email">Email</span>
                    </label>
                    <input
                      id="form-email"
                      type="email"
                      name="email"
                      placeholder="mario.rossi@azienda.it"
                      autocomplete="email"
                      required
                      aria-required="true"
                      class="contact-field"
                    />
                  </div>
                </div>

                <div class="space-y-2">
                  <label
                    for="form-subject"
                    class="font-body font-semibold text-base text-ink flex flex-wrap items-center gap-2"
                  >
                    <span data-i18n="contatti.form.oggetto">Oggetto</span>
                  </label>
                  <div class="relative">
                    <select
                      id="form-subject"
                      name="subject"
                      class="contact-field"
                    >
                      {
                        temi.map((t, ti) => (
                          <option
                            data-i18n={`contatti.form.temi.${ti}`}
                            value={t}
                          >
                            {t}
                          </option>
                        ))
                      }
                    </select>
                    <i
                      class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-ochre/50 text-sm"
                    ></i>
                  </div>
                </div>

                <div class="space-y-2">
                  <label
                    for="form-company"
                    class="font-body font-semibold text-base text-ink flex flex-wrap items-center gap-2"
                  >
                    <span data-i18n="contatti.form.azienda">Azienda / Ente</span
                    >
                    <span
                      data-i18n="contatti.form.opzionale"
                      class="font-normal text-muted text-sm"
                      >(opzionale)</span
                    >
                  </label>
                  <input
                    id="form-company"
                    type="text"
                    name="company"
                    placeholder="Comune di…, Azienda XYZ"
                    autocomplete="organization"
                    class="contact-field"
                  />
                </div>

                <div class="space-y-2">
                  <label
                    for="form-message"
                    class="font-body font-semibold text-base text-ink flex flex-wrap items-center gap-2"
                  >
                    <span data-i18n="contatti.form.messaggio">Messaggio</span>
                  </label>
                  <textarea
                    id="form-message"
                    name="message"
                    rows="6"
                    placeholder="Descrivi la tua richiesta…"
                    required
                    aria-required="true"
                    class="contact-field"
                  ></textarea>
                </div>

                <div
                  class="flex items-start gap-3 rounded-lg bg-ivory/60 p-5"
                >
                  <input
                    id="privacy"
                    type="checkbox"
                    name="privacy"
                    required
                    aria-required="true"
                    class="mt-0.5 size-5 border-linen accent-forest shrink-0 cursor-pointer"
                  />
                  <label
                    for="privacy"
                    class="font-body text-sm text-ink/80 leading-relaxed cursor-pointer"
                  >
                    <span data-i18n="contatti.form.privacy"
                      >Acconsento al trattamento dei dati personali ai sensi del</span
                    >
                    <a
                      href="/privacy"
                      class="text-forest font-semibold underline underline-offset-2 ml-1"
                      >GDPR</a
                    >.
                  </label>
                </div>

                <div
                  id="contact-form-status"
                  role="status"
                  aria-live="polite"
                  class="hidden rounded-lg font-body text-base leading-relaxed px-5 py-4 border"
                >
                </div>

                <button
                  type="submit"
                  id="contact-form-submit"
                  class="inline-flex min-h-14 w-full items-center justify-center gap-3 rounded-lg bg-forest px-6 py-4 font-body text-lg font-semibold text-ivory hover:bg-forest-mid disabled:opacity-60 disabled:cursor-wait"
                >
                  <span id="contact-form-submit-label" data-i18n="contatti.form.submit">Invia Messaggio</span>
                  <i class="fa-solid fa-paper-plane text-[11px]"></i>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════ MAP ══════════════════════ -->
  <section class="h-[520px] relative border-t border-linen overflow-hidden">
    <iframe
      src="https://maps.google.com/maps?q=Via+San+Giuseppe+42+Assoro+EN+Sicilia&output=embed&z=16&hl=it"
      class="absolute inset-0 w-full h-full border-0"
      loading="lazy"
      allowfullscreen
      referrerpolicy="no-referrer-when-downgrade"
      title="Sede Buttò S.r.l. – Via San Giuseppe 42, Assoro (EN)"></iframe>

    <div
      class="absolute inset-y-0 left-0 w-72 bg-gradient-to-r from-forest/70 to-transparent pointer-events-none z-10"
    >
    </div>

    <div
      class="absolute top-8 left-8 z-20 bg-forest border border-white/10 grain p-6 max-w-[260px] shadow-forest"
    >
      <div class="h-px w-8 bg-ochre mb-5"></div>

      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 bg-ochre flex items-center justify-center shrink-0">
          <i class="fa-solid fa-location-dot text-forest text-sm"></i>
        </div>
        <div>
          <p
            class="font-condensed font-700 text-[0.68rem] uppercase tracking-[0.16em] text-ivory"
          >
            Buttò S.r.l.
          </p>
          <p
            data-i18n="contatti.map.sede"
            class="font-body text-[0.7rem] text-ivory/40"
          >
            Sede Operativa · Assoro (EN)
          </p>
        </div>
      </div>

      <p class="font-body text-sm text-ivory/70 leading-snug mb-1">
        Via S. Giuseppe N°42
      </p>
      <p class="font-body text-sm text-ivory/50 leading-snug mb-5">
        Assoro (EN), 94010 · Sicilia
      </p>

      <a
        href="https://maps.google.com/?q=Via+San+Giuseppe+42,+Assoro,+EN,+Sicilia"
        target="_blank"
        rel="noopener noreferrer"
        class="font-condensed font-700 text-[0.65rem] uppercase tracking-[0.18em] text-ochre flex items-center gap-2 hover:gap-3 transition-all duration-200"
      >
        <i class="fa-solid fa-diamond-turn-right text-[10px]"></i>
        <span data-i18n="contatti.map.directions">Ottieni Indicazioni</span>
      </a>
    </div>
  </section>

  <script>
    import { translations } from '../i18n/translations';

    type Lang = keyof typeof translations;

    function resolveKey(obj: any, dotPath: string): string | undefined {
      const val = dotPath.split('.').reduce((o, k) => o?.[k], obj);
      return typeof val === 'string' ? val : undefined;
    }

    function currentLang(): Lang {
      return (localStorage.getItem('lang') as Lang) || 'it';
    }

    function t(key: string): string {
      const dict = translations[currentLang()] ?? translations.it;
      return resolveKey(dict, key) ?? key;
    }

    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('contact-form-status');
    const submitLabel = document.getElementById('contact-form-submit-label');
    const submitBtn = document.getElementById('contact-form-submit') as HTMLButtonElement | null;

    function showStatus(message: string, variant: 'success' | 'error') {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.remove('hidden', 'border-forest-soft', 'text-forest-soft', 'border-sienna', 'text-sienna');
      statusEl.classList.add(
        variant === 'success' ? 'border-forest-soft' : 'border-sienna',
        variant === 'success' ? 'text-forest-soft' : 'text-sienna'
      );
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const formData = new FormData(form);
      const payload = {
        name: String(formData.get('name') ?? ''),
        email: String(formData.get('email') ?? ''),
        subject: String(formData.get('subject') ?? ''),
        company: String(formData.get('company') ?? ''),
        message: String(formData.get('message') ?? ''),
        privacy: formData.get('privacy') === 'on',
        website: String(formData.get('website') ?? ''),
      };

      form.setAttribute('aria-busy', 'true');
      statusEl?.classList.add('hidden');
      if (submitBtn) submitBtn.disabled = true;
      if (submitLabel) {
        submitLabel.dataset.originalText = submitLabel.dataset.originalText ?? submitLabel.textContent ?? '';
        submitLabel.textContent = t('contatti.form.sending');
      }

      try {
        const res = await fetch('/api/contact.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json();

        if (res.ok && json.ok) {
          showStatus(t('contatti.form.success'), 'success');
          form.reset();
        } else {
          showStatus(t('contatti.form.error'), 'error');
        }
      } catch {
        showStatus(t('contatti.form.error'), 'error');
      } finally {
        form.removeAttribute('aria-busy');
        if (submitBtn) submitBtn.disabled = false;
        if (submitLabel) submitLabel.textContent = submitLabel.dataset.originalText ?? 'Invia Messaggio';
      }
    });
  </script>
</Layout>


<style>
  .contact-field {
    @apply block min-h-14 w-full rounded-lg border border-linen bg-ivory/40 px-4 py-3 font-body text-base text-ink;
  }
  .contact-field::placeholder { color: var(--muted); }
  .contact-field:focus-visible {
    outline: 2px solid var(--forest-soft);
    outline-offset: 2px;
    border-color: var(--forest-soft);
    background: white;
  }
  select.contact-field { appearance: none; padding-right: 2.5rem; }
  textarea.contact-field { resize: vertical; }
  .contact-info-link:hover { color: var(--forest-soft); text-decoration: underline; text-underline-offset: 4px; }
  .contact-info-link:focus-visible,
  #contact-form a:focus-visible,
  #contact-form button:focus-visible,
  #contact-form input[type='checkbox']:focus-visible {
    outline: 2px solid var(--forest-soft);
    outline-offset: 4px;
  }
</style>
