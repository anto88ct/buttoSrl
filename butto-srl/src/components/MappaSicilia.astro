---
// Map of Sicily with the company seat in Assoro. Geometry is generated by scripts/build-sicily-map.py.
import mappa from '../data/sicilia.json';

const { width, height, seat, provinces, cities } = mappa;
const pct = (value: number, total: number) => `${((value / total) * 100).toFixed(2)}%`;

// Side of the dot on which each label sits, chosen so labels neither collide nor leave the map.
const side: Record<string, 'left' | 'right' | 'bottom'> = {
  AG: 'bottom', CL: 'bottom', CT: 'right', EN: 'left', ME: 'left',
  PA: 'bottom', RG: 'bottom', SR: 'left', TP: 'right',
};

const directions = 'https://www.google.com/maps/dir/?api=1&destination=Via+San+Giuseppe+42%2C+94010+Assoro+EN';
---

<section class="py-24 lg:py-32 bg-forest grain text-ivory overflow-hidden" id="sede" aria-labelledby="sede-heading">
  <div class="max-w-screen-2xl mx-auto px-6 lg:px-14 relative z-10">
    <div class="sede-grid" data-sede>

      <div class="sede-intro reveal">
        <span data-i18n="chiSiamo.sede.eyebrow" class="overline text-ochre">Dove siamo</span>
        <div class="rule-ochre"></div>
        <h2 id="sede-heading" data-i18n="chiSiamo.sede.h2" class="display-sm text-ivory mt-5 italic text-balance">Ad Assoro, nel cuore della Sicilia</h2>
        <p data-i18n="chiSiamo.sede.body" class="font-body text-ivory/75 text-lg leading-relaxed mt-6 max-w-xl text-pretty">
          La nostra sede è in provincia di Enna, l'unica in Sicilia senza sbocco sul mare. Da qui operiamo nell'isola per enti pubblici e aziende private.
        </p>
        <address class="not-italic font-body text-ivory text-base mt-7">Via San Giuseppe 42, 94010 Assoro (EN)</address>
        <a href={directions} target="_blank" rel="noopener noreferrer" class="btn-primary mt-6">
          <i class="fa-solid fa-diamond-turn-right text-[11px]" aria-hidden="true"></i>
          <span data-i18n="chiSiamo.sede.directions">Indicazioni stradali</span>
        </a>
      </div>

      <figure class="sede-map">
        <div class="sede-canvas" style={`aspect-ratio: ${width} / ${height}`}>
          <svg viewBox={`0 0 ${width} ${height}`} class="absolute inset-0 w-full h-full overflow-visible" role="img" aria-labelledby="sede-map-title">
            <title id="sede-map-title" data-i18n="chiSiamo.sede.mapTitle">Cartina della Sicilia con la provincia di Enna in evidenza e la sede di Buttò ad Assoro</title>
            {provinces.filter((p) => p.code !== 'EN').map((p) => <path class="sede-province" d={p.d} />)}
            {provinces.filter((p) => p.code === 'EN').map((p) => <path class="sede-province sede-province-home" d={p.d} />)}
            {cities.map((c) => (
              <line class="sede-line" data-city={c.code} x1={seat.x} y1={seat.y} x2={c.x} y2={c.y} pathLength="1" />
            ))}
            {cities.map((c) => <circle class="sede-dot" data-city={c.code} cx={c.x} cy={c.y} r="5" />)}
            <circle class="sede-pulse" cx={seat.x} cy={seat.y} r="12" />
            <circle class="sede-seat" cx={seat.x} cy={seat.y} r="10" />
          </svg>

          <div aria-hidden="true">
            {cities.map((c) => (
              <span class={`sede-label sede-label-${side[c.code]}`} data-city={c.code} style={`left: ${pct(c.x, width)}; top: ${pct(c.y, height)}`}>
                {c.name}<span class="sede-label-km"> {c.km} km</span>
              </span>
            ))}
            <span class="sede-flag" style={`left: ${pct(seat.x, width)}; top: ${pct(seat.y, height)}`}>
              <strong class="font-display font-normal text-xl sm:text-3xl leading-none">Assoro</strong>
              <span data-i18n="chiSiamo.sede.flag" class="font-condensed font-700 text-[0.65rem] sm:text-[0.72rem] uppercase tracking-[0.14em]">La nostra sede</span>
            </span>
          </div>
        </div>
        <figcaption class="font-body text-ivory/60 text-xs mt-4 text-right">
          <span data-i18n="chiSiamo.sede.credit">Confini delle province: ISTAT, licenza CC BY</span>
        </figcaption>
      </figure>

      <div class="sede-distances">
        <h3 data-i18n="chiSiamo.sede.distances" class="font-condensed font-700 text-sm uppercase tracking-[0.14em] text-ivory/75 mb-3">Distanze in linea d'aria da Assoro</h3>
        <ul class="sede-list">
          {cities.map((c) => (
            <li>
              <button type="button" class="sede-city" data-city={c.code} aria-pressed="false">
                <span>{c.name}</span>
                <span class="tabular-nums">{c.km} km</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .sede-grid { display: grid; gap: 3rem; }
  @media (min-width: 1024px) {
    .sede-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      grid-template-areas: 'intro map' 'distances map';
      grid-template-rows: auto 1fr;
      column-gap: 5rem;
    }
    .sede-intro { grid-area: intro; }
    .sede-map { grid-area: map; align-self: center; }
    .sede-distances { grid-area: distances; }
  }
  .sede-canvas { position: relative; width: 100%; }

  .sede-province {
    fill: var(--forest-mid);
    stroke: rgb(141 180 154 / 0.5);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .sede-province-home { fill: var(--forest-soft); stroke: #D9A83F; stroke-width: 1.75; }

  /* The dash pattern covers the whole line (pathLength is 1) so that it can be drawn in. */
  .sede-line {
    stroke: rgb(242 237 223 / 0.28);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    transition: stroke 0.25s ease, stroke-width 0.25s ease;
  }
  .sede-line.is-active { stroke: #D9A83F; stroke-width: 4; }
  .sede-dot { fill: var(--ivory); transition: fill 0.25s ease; }
  .sede-dot.is-active { fill: #D9A83F; }
  .sede-seat { fill: #D9A83F; stroke: var(--forest); stroke-width: 4; }
  .sede-pulse {
    fill: none;
    stroke: #D9A83F;
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    animation: sede-pulse 2.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes sede-pulse {
    from { transform: scale(1); opacity: 0.9; }
    to   { transform: scale(4.5); opacity: 0; }
  }

  .sede-label {
    position: absolute;
    white-space: nowrap;
    pointer-events: none;
    font-size: 0.82rem;
    line-height: 1.2;
    color: var(--ivory);
    text-shadow: 0 0 4px var(--forest), 0 0 4px var(--forest);
  }
  .sede-label-left   { transform: translate(calc(-100% - 0.6rem), -50%); }
  .sede-label-right  { transform: translate(0.6rem, -50%); }
  .sede-label-bottom { transform: translate(-50%, 0.5rem); }
  .sede-label-km { display: none; font-weight: 600; }
  .sede-label.is-active {
    z-index: 2;
    background: var(--ivory);
    color: var(--forest);
    text-shadow: none;
    padding: 0.2rem 0.45rem;
  }
  .sede-label.is-active .sede-label-km { display: inline; }

  /* Seat flag: sits above and to the right of the dot, joined to it by a short stem. */
  .sede-flag {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    white-space: nowrap;
    background: #D9A83F;
    color: var(--forest);
    padding: 0.55rem 0.8rem;
    transform: translate(1.5rem, calc(-100% - 1.5rem));
  }
  .sede-flag::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 2.12rem;
    height: 2px;
    background: #D9A83F;
    transform-origin: left center;
    transform: rotate(135deg);
  }

  .sede-list { border-top: 1px solid rgb(242 237 223 / 0.14); }
  .sede-city {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 2.75rem;
    align-items: center;
    padding: 0 0.75rem;
    border-bottom: 1px solid rgb(242 237 223 / 0.14);
    color: rgb(242 237 223 / 0.85);
    text-align: left;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .sede-city.is-active { background: var(--ivory); color: var(--forest); }
  .sede-city:focus-visible { outline: 2px solid #D9A83F; outline-offset: 2px; }

  /* Narrow screens: only the chosen city is named on the map, the list carries the rest. */
  @media (max-width: 639px) {
    .sede-label:not(.is-active) { display: none; }
    .sede-flag { padding: 0.25rem 0.4rem; transform: translate(0.9rem, calc(-100% - 0.9rem)); }
    .sede-flag::after { width: 1.27rem; }
    .sede-flag strong { font-size: 0.95rem; }
    .sede-flag span { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sede-pulse { animation: none; opacity: 0; }
  }
</style>

<script>
  (() => {
    const root = document.querySelector<HTMLElement>('[data-sede]');
    if (!root) return;

    // Choosing a city in the list highlights its line, dot and label on the map.
    const buttons = root.querySelectorAll<HTMLButtonElement>('.sede-city');
    let pinned: string | null = null;
    const show = (code: string | null) => {
      root.querySelectorAll('[data-city]').forEach((el) => {
        el.classList.toggle('is-active', el.getAttribute('data-city') === code);
      });
    };
    buttons.forEach((button) => {
      const code = button.dataset.city!;
      button.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') show(code); });
      button.addEventListener('pointerleave', (event) => { if (event.pointerType === 'mouse') show(pinned); });
      button.addEventListener('focus', () => show(code));
      button.addEventListener('blur', () => show(pinned));
      button.addEventListener('click', () => {
        pinned = pinned === code ? null : code;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.city === pinned)));
        show(pinned);
      });
    });

    // The lines are drawn once, outwards from Assoro. Without this script they are simply visible.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const map = root.querySelector('.sede-canvas')!;
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      map.querySelectorAll('.sede-line').forEach((line, i) => {
        line.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], {
          duration: 900, delay: i * 90, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'backwards',
        });
      });
    }, { threshold: 0.35 });
    observer.observe(map);
  })();
</script>
