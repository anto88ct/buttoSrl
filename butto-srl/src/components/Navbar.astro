---
import LanguageSwitch from './LanguageSwitch.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const navLinks = [
  { label: 'Home', href: '/', key: 'nav.home' },
  { label: 'Chi Siamo', href: '/chi-siamo', key: 'nav.chiSiamo' },
  { label: 'Servizi', href: '/servizi', key: 'nav.servizi' },
  { label: 'Sostenibilità', href: '/sostenibilita', key: 'nav.sostenibilita' },
  { label: 'Certificazioni', href: '/certificazioni', key: 'nav.certificazioni' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
---

<header class="site-header fixed inset-x-4 top-2 z-50 mx-auto max-w-screen-2xl rounded-2xl border text-ivory shadow-lg sm:inset-x-6">
  <nav aria-label="Navigazione principale" class="nav-shell relative mx-auto flex max-w-screen-2xl items-center justify-between gap-6 px-5 py-3 sm:px-8 xl:gap-6 xl:px-10 2xl:px-12">
    <a href="/" class="brand-link shrink-0" aria-label="Buttò S.r.l. — Home">
      <Image src={logo} alt="Buttò S.r.l." class="h-10 w-auto object-contain sm:h-12" width={200} loading="eager" fetchpriority="high" />
    </a>

    <ul class="hidden items-center gap-1 xl:flex 2xl:gap-2">
      {navLinks.map(({ label, href, key }) => (
        <li>
          <a href={href} data-i18n={key} aria-current={isActive(href) ? 'page' : undefined}
            class="nav-link relative flex min-h-12 items-center whitespace-nowrap px-3 font-body text-base font-medium text-ivory/80 2xl:px-4">
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex shrink-0 items-center gap-3 sm:gap-5">
      <div class="hidden border-l border-ivory/15 pl-5 xl:block">
        <LanguageSwitch />
      </div>
      <a href="/contatti" aria-current={isActive('/contatti') ? 'page' : undefined}
        class="nav-contact hidden min-h-12 items-center justify-center gap-3 rounded-sm px-5 font-body text-base font-semibold sm:inline-flex">
        <span data-i18n="nav.contattaci">Contattaci</span>
        <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <details class="mobile-navigation xl:hidden">
        <summary class="menu-toggle flex size-12 cursor-pointer items-center justify-center rounded-sm border border-ivory/20" aria-label="Menu di navigazione">
          <svg aria-hidden="true" class="menu-bars size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
          </svg>
          <svg aria-hidden="true" class="menu-close size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="m6 6 12 12M6 18 18 6" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="mobile-panel absolute inset-x-0 top-full rounded-b-2xl border border-ivory/15 bg-forest shadow-lg">
          <div class="mx-auto max-w-screen-2xl px-5 py-5 sm:px-8">
            <ul class="divide-y divide-ivory/10">
              {navLinks.map(({ label, href, key }) => (
                <li>
                  <a href={href} aria-current={isActive(href) ? 'page' : undefined}
                    class="mobile-link flex min-h-14 items-center justify-between gap-4 px-3 py-3 font-body text-lg font-medium text-ivory/80">
                    <span data-i18n={key}>{label}</span>
                    <svg aria-hidden="true" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-ivory/15 pt-5">
              <LanguageSwitch />
              <a href="/contatti" aria-current={isActive('/contatti') ? 'page' : undefined}
                class="nav-contact inline-flex min-h-12 items-center justify-center rounded-sm px-5 font-body text-base font-semibold"
                data-i18n="nav.contattaci">Contattaci</a>
            </div>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  .site-header {
    top: max(0.5rem, env(safe-area-inset-top, 0px));
    left: max(1rem, env(safe-area-inset-left, 0px));
    right: max(1rem, env(safe-area-inset-right, 0px));
    view-transition-name: site-navigation;
    background: var(--forest);
    border-color: rgb(242 237 223 / 22%);
    box-shadow: inset 0 1px 0 rgb(242 237 223 / 15%),
      inset 0 -1px 0 rgb(242 237 223 / 5%),
      0 10px 15px -3px rgb(14 12 9 / 14%),
      0 4px 6px -4px rgb(14 12 9 / 12%);
  }

  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      background: rgb(22 44 27 / 78%);
      -webkit-backdrop-filter: blur(24px) saturate(135%);
      backdrop-filter: blur(24px) saturate(135%);
    }
    .site-header.nav-scrolled { background: rgb(22 44 27 / 84%); }
    .mobile-panel {
      background: rgb(22 44 27 / 94%);
      -webkit-backdrop-filter: blur(24px) saturate(135%);
      backdrop-filter: blur(24px) saturate(135%);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header,
    .site-header.nav-scrolled,
    .mobile-panel {
      background: var(--forest);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .nav-shell {
    padding-left: max(1.25rem, env(safe-area-inset-left, 0px));
    padding-right: max(1.25rem, env(safe-area-inset-right, 0px));
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0;
    height: 2px;
    background: var(--ochre-light);
    opacity: 0;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--ivory);
  }

  .nav-link[aria-current='page']::after {
    opacity: 1;
  }

  .nav-link:hover {
    background: rgb(242 237 223 / 5%);
  }

  .nav-contact {
    color: var(--forest);
    background: var(--ochre-light);
    border: 1px solid var(--ochre-light);
  }

  .nav-contact:hover {
    background: var(--ivory);
    border-color: var(--ivory);
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--ochre-light);
    outline-offset: 4px;
  }

  .menu-toggle {
    list-style: none;
  }

  .menu-toggle::-webkit-details-marker {
    display: none;
  }

  .menu-toggle:hover,
  details[open] .menu-toggle {
    background: rgb(242 237 223 / 10%);
    border-color: var(--ochre-light);
  }

  .menu-close,
  details[open] .menu-bars {
    display: none;
  }

  details[open] .menu-close {
    display: block;
  }

  .mobile-panel {
    max-height: calc(100dvh - var(--header-h, 5rem) - env(safe-area-inset-top, 0px));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    padding-left: env(safe-area-inset-left, 0px);
    padding-right: env(safe-area-inset-right, 0px);
  }

  .mobile-link:hover,
  .mobile-link[aria-current='page'] {
    color: var(--ochre-light);
    background: rgb(242 237 223 / 5%);
  }

  @media (min-width: 640px) {
    .site-header {
      left: max(1.5rem, env(safe-area-inset-left, 0px));
      right: max(1.5rem, env(safe-area-inset-right, 0px));
    }
    .nav-shell { padding-inline: max(2rem, env(safe-area-inset-left, 0px)); }
  }

  @media (min-width: 1280px) {
    .nav-shell { padding-inline: 2.5rem; }
  }

  @media (min-width: 1536px) {
    .nav-shell { padding-inline: 3rem; }
  }
</style>
